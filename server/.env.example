# Copy to .env and fill in the MariaDB user created in cPanel.
# The file stays on the server. Do not commit it.

MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=mindmap
MARIADB_USER=mindmap
MARIADB_PASSWORD=

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# next start binds here. cPanel's Node.js app sets PORT for you.
HOST=127.0.0.1
PORT=3000
